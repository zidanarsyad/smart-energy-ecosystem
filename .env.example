# Copy this file to .env and fill in your own free-tier keys. Optional: without keys the agents
# still work and use deterministic fallbacks instead of LLM reasoning. Never commit .env.
# Groq (tried first, fast Llama/Qwen/GPT-OSS models): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini), second in the chain: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter free models (":free" suffix), last in the chain: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# SEE_LLM=off          # switch the LLM layer off completely
